# ==============================================================================
# SUBPULSE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this template to .env.local or .env for local runtime configuration.

# --- SERVER CONFIGURATION ---
PORT=5500
NODE_ENV=development
SERVER_URL=http://localhost:5500

# --- DATABASE CONFIGURATION ---
# Local MongoDB connection URI or Docker Compose service connection string
DB_URI=mongodb://127.0.0.1:27017/subscription-tracker

# --- SECURITY & AUTHENTICATION ---
# Secrets MUST be strong cryptographic strings in production
JWT_SECRET=dev-secret-jwt-token-key-change-in-production
JWT_EXPIRES_IN=7d

# --- ARCJET BOT & RATE LIMITING PROTECTION ---
# Optional: Set to your Arcjet key or leave blank for local development fallback
ARCJET_KEY=ajkey_01h8x1
ARCJET_ENV=development

# --- UPSTASH WORKFLOW & QSTASH ---
QSTASH_URL=http://127.0.0.1:8090
QSTASH_TOKEN=mock_qstash_token
QSTASH_CURRENT_SIGNING_KEY=mock_signing_key
QSTASH_NEXT_SIGNING_KEY=mock_next_signing_key

# --- NODEMAILER EMAIL REMINDERS ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notifications@subpulse.app
EMAIL_PASS=smtp_app_password_here
EMAIL_FROM="SubPulse Reminders" <notifications@subpulse.app>

# --- LOGGING ---
# Options: error, warn, info, debug
LOG_LEVEL=info
