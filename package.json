{
  "name": "subscription-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "production": "NODE_ENV=production node app.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "check": "npm run lint && npm run format:check",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "verify": "npm run check && npm run test",
    "docs": "prettier --check \"src/docs/**/*.md\"",
    "smoke": "node scripts/smoke-test.js",
    "docker:build": "docker build -t subpulse:latest .",
    "docker:up": "docker compose --profile production up -d",
    "docker:dev": "docker compose --profile development up -d",
    "docker:down": "docker compose --profile production down",
    "docker:logs": "docker compose --profile production logs -f",
    "docker:shell": "docker exec -it subpulse-app-prod /bin/sh",
    "docker:clean": "docker compose down -v --remove-orphans && docker system prune -f"
  },
  "imports": {
    "#analytics/*": "./src/analytics/*",
    "#notifications/*": "./src/notifications/*",
    "#config/*": "./src/config/*",
    "#controllers/*": "./src/controllers/*",
    "#services/*": "./src/services/*",
    "#repositories/*": "./src/repositories/*",
    "#middleware/*": "./src/middleware/*",
    "#models/*": "./src/models/*",
    "#routes/*": "./src/routes/*",
    "#validators/*": "./src/validators/*",
    "#constants/*": "./src/constants/*",
    "#utils/*": "./src/utils/*",
    "#templates/*": "./src/templates/*"
  },
  "dependencies": {
    "@arcjet/inspect": "^1.0.0-beta.12",
    "@arcjet/node": "^1.0.0-beta.12",
    "@upstash/workflow": "^0.2.20",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "~1.4.4",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.2",
    "express": "~4.16.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "mongoose": "^8.18.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.6",
    "nodemon": "^3.1.10",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@eslint/js": "^9.36.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.1",
    "supertest": "^7.0.0"
  }
}
